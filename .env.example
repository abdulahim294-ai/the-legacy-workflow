# ============================================
# THE LEGACY Workflow - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# N8N Configuration
# ============================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=development
LOG_LEVEL=info
EXECUTIONS_DATA_PRUNE_TIMEOUT=3600
EXECUTIONS_DATA_MAX_AGE=259200

# ============================================
# Database Configuration (Supabase)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/the_legacy
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=the_legacy

# Connection pooling
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Google Drive Configuration
# ============================================
GOOGLE_DRIVE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5678/oauth/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token

# ============================================
# Anthropic Claude Configuration
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-api-key
ANTHROPIC_MODEL_DEFAULT=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-sonnet-4
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_BUCKET=production-assets

# ============================================
# GitHub Configuration
# ============================================
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=your_username
GITHUB_REPO=the-legacy-production-db
GITHUB_BRANCH=main

# ============================================
# Slack Configuration
# ============================================
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL_ALERTS=#production-alerts
SLACK_CHANNEL_LOGS=#workflow-logs

# ============================================
# Monitoring & Observability
# ============================================
# Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=us5.datadoghq.com
DATADOG_SERVICE=the-legacy-workflow

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Logging Configuration
# ============================================
LOG_FORMAT=json
LOG_LEVEL=info
LOG_FILE_PATH=./logs/workflow.log
LOG_RETENTION_DAYS=90
LOG_MAX_SIZE=100m

# ============================================
# Security Configuration
# ============================================
ENCRYPTION_KEY=your_encryption_key_32_chars_long
JWT_SECRET=your_jwt_secret_key
SESSION_SECRET=your_session_secret
CORS_ORIGIN=http://localhost:5678
API_RATE_LIMIT=100

# ============================================
# API Configuration
# ============================================
API_BASE_URL=http://localhost:5678/api/v1
API_TIMEOUT_MS=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_MS=1000

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_URL=http://localhost:5678/webhook
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_MAX_ATTEMPTS=5

# ============================================
# Feature Flags
# ============================================
FEATURE_AI_ANALYSIS=true
FEATURE_GITHUB_SYNC=true
FEATURE_SLACK_NOTIFICATIONS=true
FEATURE_ADVANCED_CACHING=true
FEATURE_PARALLEL_PROCESSING=true
FEATURE_MONITORING=true

# ============================================
# Performance Tuning
# ============================================
# Worker pool size
WORKER_COUNT=8
QUEUE_CONCURRENCY=5
BATCH_SIZE=100

# Caching
CACHE_TTL_DEFAULT=300
CACHE_TTL_LONG=3600
CACHE_MAX_SIZE_MB=512

# ============================================
# Testing Configuration
# ============================================
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/the_legacy_test
TEST_TIMEOUT_MS=30000
TEST_PARALLEL_TESTS=4

# ============================================
# Development Configuration
# ============================================
DEBUG=false
VERBOSE=false
INSPECT_MODE=false
HOT_RELOAD=true
MOCK_EXTERNAL_APIS=false

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yourcompany.com

# ============================================
# Backup & Recovery
# ============================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=s3://your-bucket/backups

# ============================================
# Compliance & Security
# ============================================
GDPR_ENABLED=true
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_DAYS=365
ENCRYPTION_AT_REST=true
ENCRYPTION_IN_TRANSIT=true

# ============================================
# Advanced Options
# ============================================
# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Custom configuration path
CONFIG_PATH=./config

# Timezone
TZ=UTC

# ============================================
# Notes
# ============================================
# 1. Generate strong secrets using: openssl rand -base64 32
# 2. Update DATABASE_URL format: postgresql://user:password@host:port/database
# 3. Get ANTHROPIC_API_KEY from: https://console.anthropic.com/
# 4. Generate GITHUB_TOKEN with scopes: repo, workflow, admin:repo_hook
# 5. Create SLACK_BOT_TOKEN with scopes: channels:manage, chat:write
# 6. For Google Drive, create OAuth 2.0 credentials in Google Cloud Console
# 7. Set up Supabase project and retrieve connection details
# 8. Configure Datadog and Sentry for production monitoring
# 9. Update CORS_ORIGIN for production environments
# 10. Never commit this file - use .env.example as template
